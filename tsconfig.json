export default function handler(req, res) {
  return res.status(200).json({
    status: "HEALTHY",
    timestamp: new Date().toISOString(),
    uptime: process.uptime(),
    services: {
      financeEngine: "VERIFIED",
      carrierEngine: "CONNECTED",
      queueWorker: "ACTIVE",
      dashboard: "RESPONSIVE",
    },
  });
}
